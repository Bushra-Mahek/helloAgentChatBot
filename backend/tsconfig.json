{
    "compilerOptions" : {
        "target": "es2025",
        "module": "esnext",
        "moduleResolution":"bundler",
        "lib":["ES2025","DOM"],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },

    "include" : ["src"]
}